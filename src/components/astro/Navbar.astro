---
import ThemeToggle from '../svelte/ThemeToggle.svelte';
const navItems = [{ href: '/', label: 'Dashboard' }];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
  <nav class="site-container py-5">
    <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-4">
      <div aria-hidden="true"></div>
      <ul class="flex flex-wrap items-center justify-center gap-6 text-lg text-slate-600 dark:text-slate-300">
        {
          navItems.map((item) => {
            const isActive = currentPath === item.href;
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'rounded-md px-2 py-1 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-400 focus:ring-offset-2 dark:hover:text-slate-100 dark:focus:ring-slate-500 dark:focus:ring-offset-slate-950',
                    isActive && 'font-semibold text-slate-900 dark:text-slate-100',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
      <div class="flex items-center gap-3 justify-self-end">
        <ThemeToggle client:load />
      </div>
    </div>
  </nav>
</header>
